class {
	for {
		val: int;
		isValueKnown: bool;
		positive: char; // 0: no, 1: yes, 2: unknown

		@argumentConstructor
		function();

		passRuntimePositive();
		missRuntimePositive();

		@condition(passRuntimePositive, missRuntimePositive)
		cndPositive: bool;
	}

	value: int;


	@constructor
	function();

	@constructor
	def<value: int>();

	@project(I: Integer)
	copy(src: Pointer<T: I>);

	printMeta();

	define<value: int>();

	@require(This.cndPositive)
	getSqrt(): int;

	give(value: int);

	@project(I: Integer)
	@require(This.cndPositive)
	@require(I.cndPositive)
	getGMean(arg: I): int;

	@condition(passRuntimePositive, missRuntimePositive)
	isPositive(): bool;

	@require(This.cndPositive)
	printToZero();

	setToAbsolute();
}
